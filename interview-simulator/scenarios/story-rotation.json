        {
          "id": "s3",
          "text": "Tell me about a time you dealt with ambiguity",
          "type": "behavioral",
          "wait_for_answer_sec": 30,
          "expected": { "mode": "behavioral", "answer_should_use_story": true, "story_different_from": "s2" }
        },
        {
          "id": "s4",
          "text": "Tell me about a time you had to mentor a teammate",
          "type": "behavioral",
          "wait_for_answer_sec": 30,
